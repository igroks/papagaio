---
# Copie para secrets.yaml e preencha. O secrets.yaml real é ignorado pelo git.
#
# Gere a chave da API com:
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"

wifi_ssid: "sua-rede"
wifi_password: "sua-senha"
ap_password: "senha-do-fallback"

api_encryption_key: "gere-uma-chave-de-32-bytes-em-base64"
ota_password: "senha-do-ota"

# Código do portão. Fica aqui, e não no papagaio.yaml, porque o controle é de
# código fixo: este número sozinho abre o portão, sem nenhum outro fator.
#
# Converta o `Valor` decimal impresso pelo firmware.ino para binário, com
# exatamente `Bits` dígitos (zeros à esquerda importam):
#   python3 -c "print(format(VALOR, '0BITSb'))"
#
# O protocolo e o pulse_length NÃO ficam aqui: não são sensíveis, e estão
# declarados direto no papagaio.yaml junto do botão.
portao_code: "000000000000000000000000"

